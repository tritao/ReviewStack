{
  "private": true,
  "workspaces": [
    "shared",
    "reviewstack",
    "reviewstack.dev",
    "textmate"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@babel/runtime": "^8.0.0",
    "@eslint/js": "^10.0.1",
    "@types/eslint__js": "^9.14.0",
    "eslint": "^10.10.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "prettier": "3.9.6",
    "typescript-eslint": "^8.69.0"
  },
  "scripts": {
    "prepare-generated": "node scripts/prepare-generated.js",
    "prestart": "yarn prepare-generated",
    "start": "yarn workspace reviewstack.dev start",
    "prebuild": "yarn prepare-generated",
    "build": "yarn workspace reviewstack.dev build",
    "pretest": "yarn prepare-generated",
    "test": "yarn workspace reviewstack test --watchAll=false && node --test oauth-worker/test/*.test.js scripts/*.test.js",
    "prepare-pages": "node scripts/prepare-pages.js",
    "test:e2e": "playwright test",
    "lint": "eslint reviewstack/src reviewstack.dev/src shared oauth-worker",
    "eslint": "eslint reviewstack/src reviewstack.dev/src shared oauth-worker",
    "eslint:fix": "eslint reviewstack/src reviewstack.dev/src shared oauth-worker --fix",
    "prettier-check": "prettier --check .",
    "prettier-fix": "prettier --write ."
  },
  "resolutions": {
    "@tootallnate/once": ">=3.0.1",
    "postcss": ">=8.4.31",
    "rollup": "3.29.5",
    "semver": ">=7.5.2",
    "serialize-javascript": ">=7.0.5",
    "underscore": ">=1.13.8"
  },
  "dependencies": {}
}
